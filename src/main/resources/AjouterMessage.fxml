<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.AjouterMessage"
            prefHeight="400.0" prefWidth="600.0">

    <VBox spacing="10" prefWidth="580.0" layoutX="10.0" layoutY="10.0">
        <!-- Zone d'affichage des messages -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" prefHeight="320.0">
            <VBox fx:id="messageContainer" spacing="10" style="-fx-padding: 10;"/>
        </ScrollPane>

        <!-- Zone de saisie du message -->
        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="messageInput" promptText="Écrivez votre message..." HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnEnvoyer" text="Envoyer"/>
        </HBox>

        <!-- Bouton pour afficher les messages -->
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnAfficherMessages" text="Afficher les Messages" onAction="#afficherMessages"/>
        </HBox>
    </VBox>
</AnchorPane>
