<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.SupprimerTransport"
      spacing="20"
      style="-fx-padding: 20; -fx-alignment: center; -fx-background-color: #E3F2FD;">

    <Label text="Supprimer un Transport"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>

    <TextField fx:id="txtIdTransport" promptText="ID Transport"/>

    <Button text="Supprimer" onAction="#deleteTransport"
            style="-fx-background-color: #E53935; -fx-text-fill: white;"/>
</VBox>
