<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.AfficherAbonnement"
      spacing="20"
      style="-fx-padding: 20; -fx-alignment: center;">

    <Label text="Liste des Abonnements"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <ListView fx:id="listAbonnements" style="-fx-pref-height: 300px;"/>

    <Button text="Retour" fx:id="btnRetour" onAction="#handleRetour"/>
</VBox>
