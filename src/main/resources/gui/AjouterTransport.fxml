<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.AfficherTransport"
      spacing="20"
      style="-fx-padding: 20; -fx-alignment: center; -fx-background-color: #E3F2FD;">

    <Label text="Liste des Transports"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>

    <ListView fx:id="listTransports" style="-fx-pref-height: 300px;"/>

    <Button text="Retour" fx:id="btnRetour" onAction="#retour"
            style="-fx-background-color: #64B5F6; -fx-text-fill: white;"/>
</VBox>
