<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.TransportController"
      spacing="20"
      style="-fx-padding: 20; -fx-font-family: Arial;">

    <!-- En-tête -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Retour" onAction="#goBack"
                style="-fx-font-size: 18px; -fx-background-color: transparent; -fx-text-fill: black; -fx-border-color: transparent;"/>
        <Label text="Gestion des Transports"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: black;"/>
    </HBox>

    <!-- Formulaire -->
    <GridPane hgap="10" vgap="10" alignment="CENTER_LEFT" style="-fx-padding: 10;">
        <Label text="Type de Transport :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbType" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Nom de la Station :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNomStation" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"
                   promptText="Ex: Gare Centrale"/>

        <Label text="Zone Géographique :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtZone" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"
                   promptText="Ex: Europe, Afrique"/>
    </GridPane>

    <!-- Boutons d'actions -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="➕ Ajouter" onAction="#addTransport"/>
        <Button text="✏️ Modifier" onAction="#updateTransport"/>
        <Button text="🗑️ Supprimer" onAction="#deleteSelectedTransport"/> <!-- ✅ Correction ici -->
        <Button text="🔄 Annuler" onAction="#clearFields"/>
    </HBox>

    <!-- Liste des transports affichés -->
    <Label text="Liste des Transports" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ScrollPane fitToWidth="true" fitToHeight="true">
        <VBox fx:id="transportDisplay" spacing="10" style="-fx-padding: 10;"/>
    </ScrollPane>

</VBox>
