<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.TransportController"
      spacing="20"
      style="-fx-padding: 20; -fx-background-color: #E3F2FD; -fx-pref-width: 800; -fx-pref-height: 600;">

    <HBox spacing="10" style="-fx-background-color: #0D47A1; -fx-padding: 10;">
        <Button text="← Retour" onAction="#goBack"
                style="-fx-background-color: #64B5F6; -fx-text-fill: white;"/>
        <Label text="Gestion des Transports"
               style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
    <Button text="Exporter PDF" onAction="#exportTransportsPDF"
            style="-fx-background-color: #43A047; -fx-text-fill: white;"/>

    <!-- Barre de recherche et tri -->
    <HBox spacing="10">
        <TextField fx:id="searchTransport" promptText="Rechercher un transport..."
                   onKeyReleased="#filterTransports"
                   style="-fx-padding: 5; -fx-pref-width: 300;"/>
        <ComboBox fx:id="cmbSortBy" promptText="Trier par" style="-fx-pref-width: 150;"/>
    </HBox>

    <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
        <Label text="Type de Transport :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbType" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Nom de la Station :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNomStation" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Ex: Station X"/>

        <Label text="Zone Géographique :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtZone" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Ex: Centre-ville"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Ajouter" onAction="#addTransport"
                style="-fx-background-color: #64B5F6; -fx-text-fill: white;"/>
        <Button text="Modifier" onAction="#updateTransport"
                style="-fx-background-color: #64B5F6; -fx-text-fill: white;"/>
        <Button text="Supprimer" onAction="#deleteTransportFromSelection"
                style="-fx-background-color: #64B5F6; -fx-text-fill: white;"/>
        <Button text="Annuler" onAction="#clearFields"
                style="-fx-background-color: #757575; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" fitToHeight="true">
        <VBox fx:id="transportDisplay"/>
    </ScrollPane>

</VBox>
