<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.AbonnementController"
      spacing="20"
      style="-fx-padding: 20; -fx-font-family: Arial;">

    <!-- En-tête -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="←" onAction="#goBack"
                style="-fx-font-size: 18px; -fx-background-color: transparent; -fx-border-color: transparent;"/>
        <Label text="Gestion des Abonnements"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Formulaire de gestion des abonnements -->
    <GridPane hgap="10" vgap="10" alignment="CENTER_LEFT" style="-fx-padding: 10;">
        <Label text="Type d'Abonnement :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboType" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Montant :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMontant" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"
                   promptText="Ex: 150.0"/>

        <Label text="Durée Valable (jours) :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDureeValable" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"
                   promptText="Ex: 30"/>

        <Label text="Statut :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboStatus" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Transport ID :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTransportId" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="200"
                   promptText="Ex: 2"/>
    </GridPane>

    <!-- Boutons d'actions -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Ajouter" onAction="#addAbonnement"/>
        <Button text="Modifier" onAction="#updateAbonnement"/>
        <Button text="Supprimer" onAction="#deleteAbonnement"/>
        <Button text="Annuler" onAction="#clearFields"/>
    </HBox>

    <!-- Liste des abonnements affichés -->
    <Label text="Liste des Abonnements" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ScrollPane fitToWidth="true" fitToHeight="true">
        <VBox fx:id="abonDisplay" spacing="10" style="-fx-padding: 10;"/>
    </ScrollPane>

</VBox>
