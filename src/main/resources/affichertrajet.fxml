<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="572.0" prefWidth="802.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.affichertrajet">
    <children>
        <!-- Search Field -->
        <TextField fx:id="searchField" layoutX="230.0" layoutY="132.0" maxWidth="511.0" prefHeight="30.0" prefWidth="470.0" promptText="Rechercher un trajet...">
            <font>
                <Font size="14.0" />
            </font>
        </TextField>

        <!-- Image -->
        <ImageView fitHeight="587.0" fitWidth="255.0" layoutX="-43.0" layoutY="-15.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@img.png" />
            </image>
        </ImageView>

        <!-- Title -->
        <Text layoutX="345.0" layoutY="88.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Liste trajets:" textAlignment="CENTER" wrappingWidth="276.45867919921875">
            <font>
                <Font name="Aldhabi" size="50.0" />
            </font>
        </Text>
        <Button fx:id="sortButton" layoutX="700.0" layoutY="133.0" prefHeight="30.0" prefWidth="90.0" stylesheets="@styles.css" text="Trier par coût" />

        <!-- ListView to display trajets -->
        <ListView fx:id="listTrajets" layoutX="230.0" layoutY="162.0" prefHeight="386.0" prefWidth="511.0" stylesheets="@styles.css" />
    </children>
</AnchorPane>
