<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MainGUIController">

    <HBox prefHeight="600" prefWidth="800" spacing="0">

        <!-- Sidebar en bleu -->
        <VBox fx:id="sidebar" alignment="CENTER" prefHeight="600" prefWidth="200" spacing="20" style="-fx-background-color: #1565C0; -fx-padding: 20;">
            <Label text="ProjectWay" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- Boutons de navigation -->
            <Button onAction="#ouvrirAccueil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" text="🏠 Accueil" />

            <Button onAction="#ouvrirGestionMissions" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" text="📌 Gérer les Missions" />

            <Button onAction="#ouvrirGestionRapports" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" text="📑 Déposer vos Rapports" />

            <Button onAction="#quitterApplication" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" text="❌ Quitter" />
        </VBox>

        <!-- Contenu principal -->
        <VBox alignment="CENTER" prefHeight="600" prefWidth="600" spacing="20">
            <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-weight: bold;" text="Bienvenue sur ProjectWay" />
        </VBox>

    </HBox>

</AnchorPane>
