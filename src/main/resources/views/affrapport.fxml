<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AfficherRapportController">

    <!-- Sidebar -->
    <VBox prefWidth="200" style="-fx-background-color: #1E3A8A; -fx-padding: 10px;">
        <Label text="ProjectWay" style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="🏠 Accueil" style="-fx-background-color: transparent; -fx-text-fill: white;" />
        <Button text="📌 Gérer les Missions" style="-fx-background-color: transparent; -fx-text-fill: white;" />
        <Button text="📂 Déposer vos Rapports" style="-fx-background-color: transparent; -fx-text-fill: white;" />
        <Button text="❌ Quitter" style="-fx-background-color: transparent; -fx-text-fill: white;" />
    </VBox>

    <VBox alignment="TOP_CENTER">
        <!-- En-tête -->
        <HBox spacing="10" style="-fx-padding: 10px; -fx-background-color: #0D47A1;">
            <Button text="⬅ Retour" style="-fx-background-color: #0D47A1; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Label text="Liste des Rapports" style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Barre de recherche -->
        <HBox spacing="10" style="-fx-padding: 10px;">
            <TextField fx:id="searchRapportField" promptText="Rechercher..." />
            <ComboBox fx:id="cbMissions" promptText="Filtrer par Mission"/>
            <Button text="🔄 Rafraîchir" fx:id="btnRafraichir" style="-fx-background-color: #1565C0; -fx-text-fill: white;"/>
        </HBox>

        <!-- Table des rapports -->
        <TableView fx:id="tableRapports" style="-fx-padding: 10px;">
            <columns>
                <TableColumn text="ID" />
                <TableColumn text="Nom Rapport" />
                <TableColumn text="Date d'Expiration" />
                <TableColumn text="Actions" />
            </columns>
        </TableView>

        <!-- Boutons d'action -->
        <HBox spacing="10" style="-fx-padding: 10px;">
            <Button text="➕ Ajouter" fx:id="btnAjouterRapport" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
            <Button text="🗑 Supprimer" fx:id="btnSupprimerRapport" style="-fx-background-color: #D32F2F; -fx-text-fill: white;" />
            <Button text="✏ Modifier" fx:id="btnModifierRapport" style="-fx-background-color: #1976D2; -fx-text-fill: white;" />
        </HBox>
    </VBox>

</BorderPane>
