<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.gui.ModifierReservation"
      alignment="CENTER"
      style="-fx-background-color: #F8F9FA; -fx-padding: 20;">

    <!-- Partie gauche: Image -->
    <ImageView fx:id="imageView" fitWidth="300" preserveRatio="true"/>

    <!-- Partie droite: Formulaire -->
    <VBox spacing="20" alignment="CENTER"
          style="-fx-padding: 40; -fx-background-color: white; -fx-background-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <Label text="Modifier une Réservation"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>

        <GridPane hgap="10" vgap="10">
            <Label text="Nom du Client :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtClientName" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Nom du Client"/>

            <Label text="Date Début :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dateDebut" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Date Fin :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dateFin" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Hébergement :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboHebergement" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <Button text="Modifier" fx:id="btnModifier" onAction="#modifierReservation"
                style="-fx-background-color: #0D47A1; -fx-text-fill: white; -fx-font-size: 16px;
                       -fx-padding: 10 30; -fx-background-radius: 5;"/>
    </VBox>

</HBox>
