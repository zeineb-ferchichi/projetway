<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.paint.Color?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.gui.Main"
      alignment="CENTER"
      style="-fx-background-color: #F1F8E9; -fx-padding: 40;"> <!-- Main container for HBox -->

    <!-- Left side: Buttons inside a VBox -->
    <VBox spacing="20" alignment="CENTER" style="-fx-padding: 20;">

        <!-- Hébergements Button -->
        <Button fx:id="btnAfficherHebergement" text="📋 Hébergements" onAction="#AfficherHebergement"
                style="-fx-font-size: 16px; -fx-background-color: #66BB6A; -fx-text-fill: white; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>

        <!-- Réservations Button -->
        <Button fx:id="btnAfficherReservation" text="📋 Réservations" onAction="#AfficherReservation"
                style="-fx-font-size: 16px; -fx-background-color: #FFC107; -fx-text-fill: black; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>

        <!-- Quitter Button -->
        <Button fx:id="btnQuitter" text="❌ Quitter" onAction="#quitter"
                style="-fx-font-size: 16px; -fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>
    </VBox>

    <!-- Right side: Welcome message and image on the left -->
    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 40; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <!-- Welcome message -->
        <Text fx:id="welcomeText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>
        <ImageView fx:id="imageView" fitWidth="120" preserveRatio="true" style="-fx-border-radius: 10; -fx-border-color: #ccc;" />

        <!-- Image on the right side -->
    </HBox>

</HBox>
