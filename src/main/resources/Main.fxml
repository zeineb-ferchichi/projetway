<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.gui.Main"
      spacing="20"
      alignment="CENTER"
      style="-fx-background-color: #F1F8E9; -fx-padding: 40;"> <!-- Correct padding style -->


    <Button fx:id="btnAfficherHebergement" text="📋 Hébergements" onAction="#AfficherHebergement"
            style="-fx-font-size: 16px; -fx-background-color: #66BB6A; -fx-text-fill: white; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>



    <!-- Section Réservation -->

    <Button fx:id="btnAfficherReservation" text="📋 Réservations" onAction="#AfficherReservation"
            style="-fx-font-size: 16px; -fx-background-color: #FFC107; -fx-text-fill: black; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>



    <!-- Quitter l'application -->
    <Button fx:id="btnQuitter" text="❌ Quitter" onAction="#quitter"
            style="-fx-font-size: 16px; -fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>
</VBox>
