<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.gui.AfficherHebergement"
      spacing="15" alignment="CENTER"
      style="-fx-padding: 20; -fx-background-color: #f9f9f9;">

    <!-- Buttons Section (Top) -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnAjouter" text="➕ Ajouter un Hébergement" onAction="#handleAjouterHebergement"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 15px; -fx-font-weight: bold;"/>
        <Button fx:id="btnRefresh" text="🔄 Actualiser" onAction="#handleRefresh"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 15px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Table Section -->
    <TableView fx:id="listHebergements" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 5px; -fx-font-size: 14px;">
        <columns>
            <TableColumn fx:id="nomCol" text="Nom" />
            <TableColumn fx:id="typeCol" text="Type" />
            <TableColumn fx:id="adresseCol" text="Adresse" />
            <TableColumn fx:id="villeCol" text="Ville" />
            <TableColumn fx:id="paysCol" text="Pays" />
            <TableColumn fx:id="capaciteCol" text="Capacité" />
            <TableColumn fx:id="prixCol" text="Prix DT" />
            <TableColumn fx:id="actionsCol" text="Actions" /> <!-- ✅ Added this column -->
        </columns>
    </TableView>

    <!-- Action Buttons (Below the Table) -->


</VBox>
