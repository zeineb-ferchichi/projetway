<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Pos?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.layout.StackPane?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.gui.AfficherHebergement"
            style="-fx-background-color: #F8F9FA;">
    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
        <!-- Header Section -->
        <HBox alignment="CENTER" spacing="20">
            <!-- StackPane pour superposer les boutons sur l'image -->
            <StackPane>
                <!-- Image de fond -->
                <ImageView fx:id="imageView" fitWidth="300" preserveRatio="true" style="-fx-border-radius: 10; -fx-border-color: #ccc;"/>

                <!-- VBox pour aligner les boutons verticalement -->
                <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
                    <!-- Hébergements Button -->
                    <Button fx:id="btnAfficherHebergement" text="📋 Hébergements" onAction="#AfficherHebergement"
                            style="-fx-font-size: 16px; -fx-background-color: #66BB6A; -fx-text-fill: white; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>

                    <!-- Réservations Button -->
                    <Button fx:id="btnAfficherReservation" text="📋 Réservations" onAction="#AfficherReservation"
                            style="-fx-font-size: 16px; -fx-background-color: #FFC107; -fx-text-fill: black; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>

                    <!-- Quitter Button -->
                    <Button fx:id="btnQuitter" text="❌ Quitter" onAction="#quitter"
                            style="-fx-font-size: 16px; -fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>
                </VBox>
            </StackPane>

            <!-- Section de la liste des hébergements -->
            <VBox spacing="15" alignment="CENTER">
                <Label text="Liste des Hébergements"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>
                <!-- Button Section -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="btnAjouter" text="➕ Ajouter un Hébergement" onAction="#handleAjouterHebergement"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-font-weight: bold; -fx-border-radius: 5px;"/>
                    <TextField fx:id="searchField" promptText="Rechercher par pays"
                               style="-fx-padding: 8px; -fx-font-size: 14px; -fx-border-radius: 5px;"/>
                    <Button fx:id="searchButton" text="🔍 Rechercher" onAction="#handleSearch"
                            style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Button fx:id="sortPriceButton" text="⬆⬇ Trier par Prix" onAction="#handleSortByPrice"
                            style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>

                <TilePane fx:id="gridHebergements"
                          style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 10px;"
                          hgap="44" vgap="10" prefColumns="3" prefTileWidth="200" prefTileHeight="200">
                    <!-- Items will be added dynamically in the controller -->
                </TilePane>
            </VBox>

        </HBox>

        <!-- Grid Section -->

    </VBox>
</ScrollPane>