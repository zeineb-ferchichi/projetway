<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Pos?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.gui.AfficherHebergement"
            style="-fx-background-color: #F8F9FA;">
    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
        <!-- Header Section -->
        <HBox alignment="CENTER" spacing="20">
            <ImageView fx:id="imageView" fitWidth="300" preserveRatio="true" style="-fx-border-radius: 10; -fx-border-color: #ccc;"/>
            <VBox spacing="15" alignment="CENTER">
                <Label text="Liste des Hébergements"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>
                <!-- Button Section -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="btnAjouter" text="➕ Ajouter un Hébergement" onAction="#handleAjouterHebergement"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-font-weight: bold; -fx-border-radius: 5px;"/>
                    <TextField fx:id="searchField" promptText="Rechercher par pays"
                               style="-fx-padding: 8px; -fx-font-size: 14px; -fx-border-radius: 5px;"/>
                    <Button fx:id="searchButton" text="🔍 Rechercher" onAction="#handleSearch"
                            style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Button fx:id="sortPriceButton" text="⬆⬇ Trier par Prix" onAction="#handleSortByPrice"
                            style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>

                <TilePane fx:id="gridHebergements"
                          style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 10px;"
                          hgap="40" vgap="10" prefColumns="4" prefTileWidth="200" prefTileHeight="200">
                    <!-- Items will be added dynamically in the controller -->
                </TilePane>
            </VBox>
        </HBox>

        <!-- Grid Section -->

    </VBox>
</ScrollPane>