<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.gui.AjouterHebergement"
      alignment="CENTER"
      style="-fx-background-color: #F8F9FA; -fx-padding: 20;">

    <!-- Left side: Image and Button -->
    <VBox spacing="15" alignment="CENTER">
        <ImageView fx:id="imageView" fitWidth="300" preserveRatio="true"
                   style="-fx-border-color: #ccc; -fx-border-width: 2px; -fx-border-radius: 5px;"/>
        <Button fx:id="btnSelectImage" text="Sélectionner une image" onAction="#selectImage"
                style="-fx-background-color: #0D47A1; -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-padding: 8 20; -fx-background-radius: 5;"/>
    </VBox>

    <!-- Right side: Form -->
    <VBox spacing="20" alignment="CENTER"
          style="-fx-padding: 40; -fx-background-color: white; -fx-background-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <Label text="Ajouter Hébergement"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>

        <GridPane hgap="10" vgap="10">
            <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNom" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Nom"/>

            <Label text="Type :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtType" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Type"/>

            <Label text="Adresse :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtAdresse" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Adresse"/>

            <Label text="Ville :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtVille" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Ville"/>

            <Label text="Pays :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPays" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="Pays"/>

            <Label text="Capacité :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCapacite" GridPane.rowIndex="5" GridPane.columnIndex="1" promptText="Capacité"/>

            <Label text="Prix :" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPrix" GridPane.rowIndex="6" GridPane.columnIndex="1" promptText="Prix"/>
        </GridPane>

        <Button text="Ajouter" fx:id="btnAjouter" onAction="#addHebergement"
                style="-fx-background-color: #0D47A1; -fx-text-fill: white; -fx-font-size: 16px;
                       -fx-padding: 10 30; -fx-background-radius: 5;"/>
    </VBox>

</HBox>
