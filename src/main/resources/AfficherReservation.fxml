<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Pos?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.gui.AfficherReservation"
      alignment="CENTER"
      style="-fx-background-color: #F8F9FA; -fx-padding: 20; -fx-spacing: 20;">

    <!-- Left Side -->
    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
        <StackPane>
            <ImageView fx:id="imageView" fitWidth="300" preserveRatio="true"
                       style="-fx-border-radius: 10; -fx-border-color: #ccc;"/>

            <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
                <Button fx:id="btnAfficherHebergement" text="📋 Hébergements" onAction="#AfficherHebergement"
                        style="-fx-font-size: 16px; -fx-background-color: #66BB6A; -fx-text-fill: white;
                               -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>

                <Button fx:id="btnAfficherReservation" text="📋 Réservations" onAction="#AfficherReservation"
                        style="-fx-font-size: 16px; -fx-background-color: #FFC107; -fx-text-fill: black;
                               -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>

                <Button fx:id="btnQuitter" text="❌ Quitter" onAction="#quitter"
                        style="-fx-font-size: 16px; -fx-background-color: #F44336; -fx-text-fill: white;
                               -fx-padding: 10 20; -fx-border-radius: 5; -fx-font-weight: bold;"/>
            </VBox>
        </StackPane>
    </VBox>

    <!-- Right Side -->
    <VBox spacing="15" alignment="CENTER"
          style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <Label text="Liste des Réservations"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0D47A1; -fx-padding: 10 0 20 0;"/>

        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 0 0 20 0;">
            <TextField fx:id="searchField" promptText="Rechercher par nom..."
                       style="-fx-font-size: 14px; -fx-padding: 8px 10px; -fx-border-radius: 5px;"/>
            <Button fx:id="searchButton" text="🔍 Rechercher" onAction="#handleSearch"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-padding: 8px 15px; -fx-border-radius: 5px;"/>
        </HBox>

        <TableView fx:id="tableReservations" style="-fx-background-color: white; -fx-border-color: #ccc;
                                                    -fx-border-radius: 10px; -fx-font-size: 14px;">
            <columns>
                <TableColumn fx:id="clientCol" text="Nom du Client" prefWidth="120" />
                <TableColumn fx:id="dateDebutCol" text="Date Début" />
                <TableColumn fx:id="dateFinCol" text="Date Fin" />
                <TableColumn fx:id="hebergementCol" text="Nom d'Hébergement" prefWidth="150"/>
                <TableColumn fx:id="actionsCol" text="Actions" />
            </columns>
        </TableView>

        <ImageView fx:id="imageViewQRCode" fitWidth="200" fitHeight="200" preserveRatio="true"
                   style="-fx-border-radius: 10; -fx-border-color: #ccc; -fx-padding: 20;"/>
    </VBox>
</HBox>