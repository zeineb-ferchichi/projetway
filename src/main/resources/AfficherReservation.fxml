<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Pos?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.gui.AfficherReservation"
      alignment="CENTER"
      style="-fx-background-color: #F8F9FA; -fx-padding: 20; -fx-spacing: 20;">

    <!-- Left side: Image -->
    <ImageView fx:id="imageView" fitWidth="300" preserveRatio="true" style="-fx-border-radius: 10; -fx-border-color: #ccc;"/>

    <!-- Right side: Table and Buttons -->
    <VBox spacing="15" alignment="CENTER"
          style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <!-- Title -->
        <Label text="Liste des Réservations"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0D47A1; -fx-padding: 10 0 20 0;"/>

        <!-- Button Section -->
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 0 0 20 0;">
            <Button fx:id="btnAjouter" text="➕ Ajouter une Réservation" onAction="#handleAjouterReservation"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-padding: 10px 20px; -fx-font-weight: bold; -fx-border-radius: 5px;"/>
            <Button fx:id="btnRefresh" text="🔄 Actualiser" onAction="#handleRefresh"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-padding: 10px 20px; -fx-font-weight: bold; -fx-border-radius: 5px;"/>
        </HBox>

        <!-- Table Section -->
        <TableView fx:id="tableReservations" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 10px; -fx-font-size: 14px;">
            <columns>
                <TableColumn fx:id="clientCol" text="Nom du Client" prefWidth="120" />
                <TableColumn fx:id="dateDebutCol" text="Date Début" />
                <TableColumn fx:id="dateFinCol" text="Date Fin" />
                <TableColumn fx:id="hebergementCol" text="Nom d'Hébergement" prefWidth="150"/>
                <TableColumn fx:id="actionsCol" text="Actions" />
            </columns>
        </TableView>

        <!-- QR Code Section -->
        <ImageView fx:id="imageViewQRCode" fitWidth="200" fitHeight="200" preserveRatio="true" style="-fx-border-radius: 10; -fx-border-color: #ccc; -fx-padding: 20;"/>
    </VBox>
</HBox>
