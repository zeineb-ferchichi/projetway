<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.gui.AfficherReservation"
      spacing="15" alignment="CENTER"
      style="-fx-padding: 20; -fx-background-color: #f9f9f9;">

    <!-- Buttons Section (Top) -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnAjouter" text="➕ Ajouter une Réservation" onAction="#handleAjouterReservation"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 15px; -fx-font-weight: bold;"/>
        <Button fx:id="btnRefresh" text="🔄 Actualiser" onAction="#handleRefresh"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 15px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Table Section -->
    <TableView fx:id="tableReservations" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 5px; -fx-font-size: 14px;">
        <columns>
            <TableColumn fx:id="clientCol" text="Nom du Client" prefWidth="120" />
            <TableColumn fx:id="dateDebutCol" text="Date Début" />
            <TableColumn fx:id="dateFinCol" text="Date Fin" />
            <TableColumn fx:id="hebergementCol" text="Nom d'Hébergement" prefWidth="150"/>
            <TableColumn fx:id="actionsCol" text="Actions" />
        </columns>
    </TableView>

</VBox>
