<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.addmission">
    <children>
        <TextField fx:id="TFNomMission" layoutX="76.0" layoutY="92.0" promptText="Age" />
        <Label layoutX="76.0" layoutY="67.0" prefHeight="17.0" prefWidth="118.0" text="nom mission" />
        <Label layoutX="76.0" layoutY="139.0" prefHeight="17.0" prefWidth="118.0" text="date_debut" />
        <Label layoutX="76.0" layoutY="209.0" text="date_fin" />
        <Button fx:id="addM" layoutX="421.0" layoutY="321.0" mnemonicParsing="false" onAction="#ajouterMission" text="Ajouter" />
        <Button fx:id="affM" layoutX="486.0" layoutY="321.0" mnemonicParsing="false" onAction="#afficherMissions" text="Afficher" />
      <TextField fx:id="TFDesc" layoutX="76.0" layoutY="284.0" />
      <Label layoutX="76.0" layoutY="267.0" text="description" />
      <DatePicker fx:id="DPDateDebut" layoutX="76.0" layoutY="167.0" />
      <DatePicker fx:id="DPDateFin" layoutX="76.0" layoutY="226.0" />
        <Label layoutX="76.0" layoutY="325.0" text="Statut de la Mission" />
        <ComboBox fx:id="cbStatut" layoutX="78.0" layoutY="346.0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="EN_COURS" />
                    <String fx:value="TERMINE" />
                    <String fx:value="EN_ATTENTE" />
                </FXCollections>
            </items>
        </ComboBox>


    </children>
</AnchorPane>
